# The default fictional demo runs entirely in each visitor's browser.
# No environment variables, database service or upload service are required.
# OPTIONAL: opt into the original server API before configuring these variables.
# NEXT_PUBLIC_DATA_MODE=server
# In server mode, set these locally in .env.local or in Vercel project settings.
# Local server mode uses .data if storage variables are absent; Vercel requires
# hosted credentials only when server mode is explicitly selected.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token
# Connect a PRIVATE Vercel Blob store to supply this server-only token.
# BLOB_READ_WRITE_TOKEN=your-private-store-token
TEST_BASE_URL=http://127.0.0.1:5173
# External email, routing, payments, identity documents and analytics disabled.
# Browser demo sessions and all role data are local simulations, not real accounts.
# Do not deploy this build as a real marketplace without implementing production auth,
# staff MFA, mail delivery, retention and the launch checks in docs/decisions.md.
